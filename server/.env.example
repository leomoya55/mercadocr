# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── MongoDB Atlas ──────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# ─── Stripe ─────────────────────────────────────────────────────────────────────
# Use sk_live_… in production, sk_test_… in a test/staging deploy.
STRIPE_SECRET_KEY=sk_live_...
# Signing secret of the LIVE-mode webhook endpoint (Dashboard → Developers →
# Webhooks). A test-mode secret will NOT verify live events.
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly Price IDs (Dashboard → Products). REQUIRED for proration on
# upgrades/downgrades. Without them, checkout still works via inline price_data
# but tier changes cannot be prorated.
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...

# ─── Cloudinary (image uploads) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ─── Firebase Admin (server-side token verification) ────────────────────────────
FIREBASE_PROJECT_ID=<your-firebase-project-id>
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com
# Keep the literal \n escapes — the server converts them to real newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── App config ─────────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins (your production domain(s)).
ALLOWED_ORIGINS=https://your-domain.com
# Platform owner — always treated as Pro / admin.
FOUNDER_EMAIL=your-founder-email@example.com

# ─── Cron (Vercel Cron backstop for expired subscriptions) ──────────────────────
# A long random string. Vercel automatically sends it as a Bearer token to cron
# invocations; the /api/cron/* routes reject any request without it.
CRON_SECRET=<generate-a-long-random-string>
